# Copy to .env and edit. Every value defaults to the in-memory/mock backend,
# so the app runs with NONE of this set. Flip a value to use real infra
# (after `docker compose -f infra/docker-compose.yml up -d`).

# --- LLM: mock | anthropic ---
AGENT_LLM_PROVIDER=mock
# AGENT_ANTHROPIC_API_KEY=sk-ant-...
# AGENT_ANTHROPIC_MODEL=claude-sonnet-4-6

# --- State checkpointing: memory | redis ---
AGENT_CHECKPOINTER=memory
# AGENT_CHECKPOINTER=redis
# AGENT_REDIS_URL=redis://localhost:6379/0

# --- Conversation storage: memory | postgres ---
AGENT_CONVERSATION_STORE=memory
# AGENT_CONVERSATION_STORE=postgres
# AGENT_POSTGRES_DSN=postgresql+asyncpg://agent:agent@localhost:5432/agent

# --- Vector DB / RAG: memory | qdrant ---
AGENT_VECTORSTORE=memory
# AGENT_VECTORSTORE=qdrant
# AGENT_QDRANT_URL=http://localhost:6333
# AGENT_QDRANT_COLLECTION=agent_docs

# --- Distributed events: memory | kafka ---
AGENT_EVENTBUS=memory
# AGENT_EVENTBUS=kafka
# AGENT_KAFKA_BOOTSTRAP=localhost:9092
# AGENT_KAFKA_TOPIC=agent.runs

# --- Tracing (OpenTelemetry -> Jaeger) ---
AGENT_TRACING_ENABLED=false
# AGENT_TRACING_ENABLED=true
# AGENT_OTLP_ENDPOINT=http://localhost:4317

# --- Eval tracking (MLflow) ---
AGENT_MLFLOW_ENABLED=false
# AGENT_MLFLOW_ENABLED=true
# AGENT_MLFLOW_TRACKING_URI=http://localhost:5001   # compose maps mlflow to 5001 on macOS

# --- Agent behaviour ---
AGENT_MAX_ITERATIONS=2
AGENT_EVAL_THRESHOLD=0.7
AGENT_SERVICE_URL=http://localhost:8000
